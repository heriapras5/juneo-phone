# ================================================================
# Production Environment Configuration for Juneo Phone Service System
# ================================================================

# Application
APP_NAME="Juneo Phone"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://juneophone.com

# Locale
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Security
BCRYPT_ROUNDS=12
SESSION_SECURE_COOKIE=true

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_juneo
DB_USERNAME=juneo_user
DB_PASSWORD="strong_password_here"

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.juneophone.com

# Cache
CACHE_STORE=file

# Queue
QUEUE_CONNECTION=database

# Mail (for password reset, notifications)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@juneophone.com
MAIL_PASSWORD="email_password_here"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@juneophone.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth
GOOGLE_CLIENT_ID="your_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_client_secret"
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# File Storage
FILESYSTEM_DISK=local

# ================================================================
# 📌 DEPLOYMENT CHECKLIST
# ================================================================
#
# 1. Generate APP_KEY:
#    php artisan key:generate
#
# 2. Run migrations:
#    php artisan migrate --force
#
# 3. Run seeders (SuperAdmin):
#    php artisan db:seed --class=SuperAdminSeeder --force
#
# 4. Set proper permissions:
#    chmod -R 755 storage bootstrap/cache
#    chown -R www-data:www-data storage bootstrap/cache
#
# 5. Configure cron:
#    * * * * * cd /path/to/project && php artisan schedule:run >> /dev/null 2>&1
#
# 6. Configure queue worker (if using queue):
#    php artisan queue:work --daemon --sleep=3 --tries=3
#
# 7. Set up HTTPS (required for OAuth and security)
#
# 8. Test all critical flows:
#    - Login (email & Google)
#    - Service CRUD
#    - Dashboard statistics
#    - Report exports
#    - User management
#
# ================================================================
# 🛡️ SECURITY BEST PRACTICES
# ================================================================
#
# - Keep APP_DEBUG=false in production
# - Use strong database password
# - Regularly rotate APP_KEY and OAuth credentials
# - Enable database backups
# - Monitor logs (LOG_LEVEL=error)
# - Use HTTPS for all traffic
# - Restrict database access to localhost or trusted IPs
# - Regularly update Laravel and dependencies
#
# ================================================================
